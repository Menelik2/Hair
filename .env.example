# ============================================================
# Elite Cuts — Environment Configuration
# Copy this file to .env and fill in your real values.
# ============================================================

# Database (AeonFree: use the credentials from your Control Panel → MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Application
APP_ENV=production
